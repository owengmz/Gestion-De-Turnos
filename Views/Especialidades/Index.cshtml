@model IEnumerable<mvc.Models.Especialidad>

@{
    ViewData["Title"] = "Especialidades Médicas";
    var currentSearch = ViewBag.Search as string;
    var currentFilter = ViewBag.EstadoFiltro as string ?? "todos";
    var isAdmin = User.IsInRole("Administrador");
}

<div class="py-3">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center shadow-sm mb-4" role="alert">
            <svg class="bi flex-shrink-0 me-2" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
            </svg>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- Encabezado -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h3 fw-bold mb-1" style="color: var(--teal, #216d68);">Catálogo de Especialidades</h1>
            <p class="text-muted mb-0">Gestión y administración de especialidades médicas de la clínica.</p>
        </div>
        @if (isAdmin)
        {
            <div>
                <a asp-action="Create" class="btn app-button-primary px-3 shadow-sm d-inline-flex align-items-center gap-2">
                    <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2z"/>
                    </svg>
                    <span>Nueva Especialidad</span>
                </a>
            </div>
        }
    </div>

    <!-- Barra de Búsqueda y Filtros -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; background: #ffffff;">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-12 col-md-6 col-lg-7">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0 text-muted">
                            <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                            </svg>
                        </span>
                        <input type="text" name="search" value="@currentSearch" class="form-control border-start-0" 
                               placeholder="Buscar por nombre o descripción..." />
                    </div>
                </div>
                <div class="col-6 col-md-3 col-lg-3">
                    <select name="estadoFiltro" class="form-select">
                        <option value="todos" selected="@(currentFilter == "todos")">Todos los estados</option>
                        <option value="activos" selected="@(currentFilter == "activos")">Solo activas</option>
                        <option value="inactivos" selected="@(currentFilter == "inactivos")">Solo inactivas</option>
                    </select>
                </div>
                <div class="col-6 col-md-3 col-lg-2 d-flex gap-2">
                    <button type="submit" class="btn btn-outline-secondary w-100">Filtrar</button>
                    @if (!string.IsNullOrWhiteSpace(currentSearch) || currentFilter != "todos")
                    {
                        <a asp-action="Index" class="btn btn-light border text-muted" title="Limpiar filtros">✕</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla de Especialidades -->
    <div class="card border-0 shadow-sm" style="border-radius: 12px; overflow: hidden;">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color: #f1f6f4; border-bottom: 2px solid #dce6e1;">
                    <tr>
                        <th class="ps-4 text-secondary text-uppercase fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.05em; width: 80px;">ID</th>
                        <th class="text-secondary text-uppercase fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.05em;">Nombre</th>
                        <th class="text-secondary text-uppercase fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.05em;">Descripción</th>
                        <th class="text-secondary text-uppercase fw-semibold text-center" style="font-size: 0.75rem; letter-spacing: 0.05em; width: 140px;">Profesionales</th>
                        <th class="text-secondary text-uppercase fw-semibold text-center" style="font-size: 0.75rem; letter-spacing: 0.05em; width: 120px;">Estado</th>
                        @if (isAdmin)
                        {
                            <th class="pe-4 text-secondary text-uppercase fw-semibold text-end" style="font-size: 0.75rem; letter-spacing: 0.05em; width: 190px;">Acciones</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var countProfesionales = item.Profesionales?.Count ?? 0;
                            <tr class="@(!item.estado ? "table-light opacity-75" : "")">
                                <td class="ps-4 fw-semibold text-muted">#@item.id</td>
                                <td>
                                    <span class="fw-bold text-dark">@item.nombre</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.descripcion))
                                    {
                                        <span class="text-muted">@item.descripcion</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Sin descripción</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border px-2 py-1 rounded-pill">
                                        👤 @countProfesionales
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (item.estado)
                                    {
                                        <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-3 py-1">
                                            Activa
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-1">
                                            Inactiva
                                        </span>
                                    }
                                </td>
                                @if (isAdmin)
                                {
                                    <td class="pe-4 text-end">
                                        <div class="d-inline-flex gap-1">
                                            <a asp-action="Edit" asp-route-id="@item.id" class="btn btn-sm btn-outline-primary" title="Editar especialidad">
                                                <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                                    <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/>
                                                </svg>
                                                <span class="d-none d-sm-inline ms-1">Editar</span>
                                            </a>
                                            <form asp-action="ToggleEstado" asp-route-id="@item.id" method="post" class="d-inline"
                                                  onsubmit="return confirm('¿Está seguro de que desea @(item.estado ? "desactivar" : "activar") la especialidad @item.nombre?');">
                                                @Html.AntiForgeryToken()
                                                @if (item.estado)
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="Desactivar (Baja lógica)">
                                                        <span class="d-none d-sm-inline">Desactivar</span>
                                                        <span class="d-sm-none">⏸</span>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Activar">
                                                        <span class="d-none d-sm-inline">Activar</span>
                                                        <span class="d-sm-none">▶</span>
                                                    </button>
                                                }
                                            </form>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(isAdmin ? 6 : 5)" class="text-center py-5">
                                <div class="text-muted">
                                    <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="mb-2 opacity-50">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                                    </svg>
                                    <p class="h6 fw-normal mb-1">No se encontraron especialidades</p>
                                    <small class="text-muted">Prueba cambiando los filtros o agregando una nueva especialidad.</small>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
