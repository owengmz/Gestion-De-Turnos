@model IEnumerable<mvc.Models.HorarioAtencion>
    
@{
    ViewData["Title"] = "Horarios de Atención";
}

<div class="container-fluid mt-4" id="appHorarios">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Horarios de Atención</h2>
            <p class="text-muted mb-0">
                Administración de los horarios disponibles de los profesionales.
            </p>
        </div>

        <a asp-controller="HorariosAtencion"
           asp-action="Create"
           class="btn text-white px-4 py-3"
           style="background-color: #2f706b; border-radius: 8px;">
            <strong>Crear Horario</strong>
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Profesional</th>
                            <th>Día</th>
                            <th>Desde</th>
                            <th>Hasta</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr v-if="cargando">
                            <td colspan="6" class="text-center py-4">
                                Cargando horarios...
                            </td>
                        </tr>

                        <tr v-else-if="horarios.length === 0">
                            <td colspan="6" class="text-center text-muted py-4">
                                No hay horarios registrados.
                            </td>
                        </tr>

                        <tr v-for="horario in horarios" :key="horario.id">
                            <td>{{ horario.profesional }}</td>
                            <td>{{ horario.dia }}</td>
                            <td>{{ horario.horaDesde }}</td>
                            <td>{{ horario.horaHasta }}</td>

                            <td>
                                <span v-if="horario.estado" class="badge bg-success">
                                    Activo
                                </span>
                                <span v-else class="badge bg-secondary">
                                    Inactivo
                                </span>
                            </td>

                            <td>
                                <a :href="'/HorariosAtencion/Edit/' + horario.id"
                                class="btn btn-sm text-white"
                                style="background-color: #2f706b;">
                                    Editar
                                </a>
                            </td>
                        </tr>
                    </tbody>

                </table>
                 <!-- PAGINACION VUE -->
                <nav class="mt-4" v-if="totalPaginas > 1">
                    <ul class="pagination justify-content-center">

                        <li class="page-item" :class="{ disabled: paginaActual === 1 }">
                            <button class="page-link"
                                    @@click="cambiarPagina(paginaActual - 1)"
                                    :disabled="paginaActual === 1">
                                Anterior
                            </button>
                        </li>

                        <li v-for="pagina in totalPaginas"
                            :key="pagina"
                            class="page-item"
                            :class="{ active: paginaActual === pagina }">

                            <button class="page-link"
                                    @@click="cambiarPagina(pagina)">
                                {{ pagina }}
                            </button>
                        </li>

                        <li class="page-item"
                            :class="{ disabled: paginaActual === totalPaginas }">

                            <button class="page-link"
                                    @@click="cambiarPagina(paginaActual + 1)"
                                    :disabled="paginaActual === totalPaginas">
                                Siguiente
                            </button>
                        </li>

                    </ul>
                </nav>

                <div class="text-muted text-center mt-2">
                    Total de horarios: {{ totalRegistros }}
                </div>

            </div>

        </div>
    </div>
</div>

// VUE 3 CDN
<script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>

<script>
    const { createApp } = Vue;

    createApp({
        data() {
            return {
                horarios: [],
                paginaActual: 1,
                totalPaginas: 1,
                totalRegistros: 0,
                cargando: false
            };
        },

        methods: {
            async cargarHorarios(pagina = 1) {
                this.cargando = true;

                try {
                    const respuesta = await fetch(
                        '@Url.Action("ListarJson", "HorariosAtencion")?pagina=' + pagina
                    );

                    if (!respuesta.ok) {
                        throw new Error('No se pudieron cargar los horarios.');
                    }

                    const datos = await respuesta.json();

                    this.horarios = datos.datos;
                    this.paginaActual = datos.paginaActual;
                    this.totalPaginas = datos.totalPaginas;
                    this.totalRegistros = datos.totalRegistros;

                } catch (error) {
                    alert(error.message);
                } finally {
                    this.cargando = false;
                }
            },

            cambiarPagina(pagina) {
                if (pagina < 1 || pagina > this.totalPaginas) {
                    return;
                }

                this.cargarHorarios(pagina);
            }
        },

        mounted() {
            this.cargarHorarios();
        }

    }).mount('#appHorarios');
</script>