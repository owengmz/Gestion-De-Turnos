@model IEnumerable<mvc.Models.HorarioAtencion>

@{
    ViewData["Title"] = "Horarios de Atención";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Horarios de Atención</h2>
            <p class="text-muted mb-0">
                Administración de los horarios disponibles de los profesionales.
            </p>
        </div>

        <a asp-controller="HorariosAtencion"
           asp-action="Create"
           class="btn text-white px-4 py-3"
           style="background-color: #2f706b; border-radius: 8px;">
            <strong>Crear Horario</strong>
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Profesional</th>
                            <th>Día</th>
                            <th>Desde</th>
                            <th>Hasta</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    No hay horarios registrados.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var horario in Model)
                            {
                                <tr>
                                    <td>
                                        @(horario.Profesional != null
                                            ? $"{horario.Profesional.nombre} {horario.Profesional.apellido}"
                                            : "Profesional no disponible")
                                    </td>

                                    <td>@horario.dia_semana</td>

                                    <td>@horario.hora_desde.ToString(@"hh\:mm")</td>

                                    <td>@horario.hora_hasta.ToString(@"hh\:mm")</td>

                                    <td>
                                        @if (horario.estado)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactivo</span>
                                        }
                                    </td>

                                    <td>
                                        <a asp-action="Edit"
                                           asp-route-id="@horario.id"
                                           class="btn btn-sm text-white"
                                           style="background-color: #2f706b;">
                                            Editar
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>
</div>