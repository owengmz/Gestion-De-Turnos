@model mvc.Models.ResultadoPaginado<mvc.Models.Paciente>

@{
  ViewData["Title"] = "Pacientes sin turnos";
  var buscar = ViewBag.Buscar as string;
  var totalPaginas = Model.TotalPaginas == 0 ? 1 : Model.TotalPaginas;
}

<div class="py-3">

  <!-- encabezado -->
  <div
    class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-2 border-bottom">
    <div>
      <h1 class="h3 fw-bold mb-1" style="color: var(--teal, #216d68);">Pacientes sin turnos</h1>
      <p class="text-muted mb-0">Pacientes activos que todavia no tienen ningun turno registrado.</p>
    </div>
  </div>

  <!-- busqueda -->
  <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; background: #ffffff;">
    <div class="card-body p-3">
      <form method="get" asp-action="SinTurnos" class="row g-2 align-items-center">
        <div class="col-12 col-md-8 col-lg-9">
          <input type="text" name="buscar" value="@buscar" class="form-control"
                 placeholder="Buscar por DNI, nombre o apellido..." />
        </div>
        <div class="col-12 col-md-4 col-lg-3 d-flex gap-2">
          <button type="submit" class="btn btn-outline-secondary w-100">Buscar</button>
          @if (!string.IsNullOrWhiteSpace(buscar))
          {
            <a asp-action="SinTurnos" class="btn btn-light border text-muted" title="Limpiar busqueda">Limpiar</a>
          }
        </div>
      </form>
    </div>
  </div>

  <!-- tabla -->
  <div class="card border-0 shadow-sm" style="border-radius: 12px; overflow: hidden;">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead style="background-color: #f1f6f4; border-bottom: 2px solid #dce6e1;">
          <tr>
            <th class="ps-4 text-secondary text-uppercase fw-semibold"
                style="font-size: 0.75rem; letter-spacing: 0.05em;">DNI</th>
            <th class="text-secondary text-uppercase fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.05em;">
              Paciente</th>
              <th class="text-secondary text-uppercase fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                Nacimiento</th>
                <th class="text-secondary text-uppercase fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                  Telefono</th>
                  <th class="text-secondary text-uppercase fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                    Obra social</th>
                    <th class="text-secondary text-uppercase fw-semibold text-end pe-4"
                        style="font-size: 0.75rem; letter-spacing: 0.05em;">Detalle</th>
                  </tr>
                </thead>
                <tbody>
                  @if (Model.Registros.Any())
                  {
                    foreach (var item in Model.Registros)
                    {
                      <tr>
                        <td class="ps-4 fw-semibold text-muted">@item.dni</td>
                        <td><span class="fw-bold text-dark">@item.apellido, @item.nombre</span></td>
                        <td class="text-muted">@(item.fecha_nacimiento.HasValue? item.fecha_nacimiento.Value.ToString("dd/MM/yyyy")
                                      : "-")</td>
                          <td class="text-muted">@(string.IsNullOrWhiteSpace(item.telefono) ? "-" : item.telefono)</td>
                          <td>
                            @if (item.ObraSocial != null)
                            {
                              <span class="text-dark">@item.ObraSocial.nombre</span>
                            }
                            else
                            {
                              <span class="text-muted fst-italic">Sin obra social</span>
                            }
                          </td>
                          <td class="text-end pe-4">
                            <a asp-controller="Pacientes" asp-action="Detalles" asp-route-id="@item.id"
                               class="btn btn-outline-secondary btn-sm">Detalles</a>
                          </td>
                        </tr>
                      }
                    }
          else
                    {
                      <tr>
                        <td colspan="6" class="text-center py-5">
                          <p class="h6 fw-normal mb-1 text-muted">No hay pacientes sin turnos</p>
                          <small class="text-muted">Todos los pacientes activos tienen al menos un turno, o la busqueda no
                            coincide.</small>
                          </td>
                        </tr>
                      }
                    </tbody>
                  </table>
                </div>

                <!-- paginado -->
                <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
                  <small class="text-muted">@Model.TotalRegistros registros - pagina @Model.Pagina de @totalPaginas</small>
                  <div>
                    <a asp-action="SinTurnos" asp-route-pagina="@(Model.Pagina - 1)" asp-route-buscar="@buscar"
                       class="btn btn-outline-secondary btn-sm me-1 @(Model.TienePaginaAnterior ? "" : "disabled")">Anterior</a>
                    <a asp-action="SinTurnos" asp-route-pagina="@(Model.Pagina + 1)" asp-route-buscar="@buscar"
                       class="btn btn-outline-secondary btn-sm @(Model.TienePaginaSiguiente ? "" : "disabled")">Siguiente</a>
                  </div>
                </div>
              </div>
            </div>