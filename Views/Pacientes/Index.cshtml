@model mvc.Models.ResultadoPaginado<mvc.Models.Paciente>

@{
  ViewData["Title"] = "Pacientes";
  var buscar = ViewBag.Buscar as string;
  var filtro = ViewBag.EstadoFiltro as string ?? "todos";
  var totalPaginas = Model.TotalPaginas == 0 ? 1 : Model.TotalPaginas;
  // mismos roles que autoriza el controlador
  var puedeGestionar = User.IsInRole("Administrador") || User.IsInRole("Recepcionista");
  var esAdmin = User.IsInRole("Administrador");
}

<div class="py-3">

  <!-- encabezado -->
  <div
    class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-2 border-bottom">
    <div>
      <h1 class="h3 fw-bold mb-1" style="color: var(--teal, #216d68);">Pacientes</h1>
      <p class="text-muted mb-0">Gestion y consulta de los pacientes registrados en la clinica.</p>
    </div>
    @if (puedeGestionar)
    {
      <a asp-action="Crear" class="btn app-button-primary px-4">Nuevo paciente</a>
    }
  </div>

  <!-- mensajes del controlador -->
  @if (TempData["Mensaje"] is string mensaje)
  {
    <div class="alert alert-success py-2 small" role="alert">@mensaje</div>
  }
  @if (TempData["Error"] is string error)
  {
    <div class="alert alert-danger py-2 small" role="alert">@error</div>
  }

  <!-- busqueda y filtros -->
  <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; background: #ffffff;">
    <div class="card-body p-3">
      <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-12 col-md-6 col-lg-7">
          <input type="text" name="buscar" value="@buscar" class="form-control"
                 placeholder="Buscar por DNI, nombre o apellido..." />
        </div>
        <div class="col-6 col-md-3 col-lg-3">
          <select name="estadoFiltro" class="form-select">
            <option value="todos" selected="@(filtro == "todos")">Todos los estados</option>
            <option value="activos" selected="@(filtro == "activos")">Solo activos</option>
            <option value="inactivos" selected="@(filtro == "inactivos")">Solo inactivos</option>
          </select>
        </div>
        <div class="col-6 col-md-3 col-lg-2 d-flex gap-2">
          <button type="submit" class="btn btn-outline-secondary w-100">Filtrar</button>
          @if (!string.IsNullOrWhiteSpace(buscar) || filtro != "todos")
          {
            <a asp-action="Index" class="btn btn-light border text-muted" title="Limpiar filtros">Limpiar</a>
          }
        </div>
      </form>
    </div>
  </div>

  <!-- tabla -->
  <div class="card border-0 shadow-sm" style="border-radius: 12px; overflow: hidden;">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead style="background-color: #f1f6f4; border-bottom: 2px solid #dce6e1;">
          <tr>
            <th class="ps-4 text-secondary text-uppercase fw-semibold"
                style="font-size: 0.75rem; letter-spacing: 0.05em;">DNI</th>
            <th class="text-secondary text-uppercase fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.05em;">
              Paciente</th>
              <th class="text-secondary text-uppercase fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                Telefono</th>
                <th class="text-secondary text-uppercase fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                  Obra social</th>
                  <th class="text-secondary text-uppercase fw-semibold text-center"
                      style="font-size: 0.75rem; letter-spacing: 0.05em; width: 120px;">Estado</th>
                  <th class="text-secondary text-uppercase fw-semibold text-end pe-4"
                      style="font-size: 0.75rem; letter-spacing: 0.05em;">Acciones</th>
                </tr>
              </thead>
              <tbody>
                @if (Model.Registros.Any())
                {
                  foreach (var item in Model.Registros)
                  {
                    <tr class="@(!item.estado ? "table-light opacity-75" : "")">
                      <td class="ps-4 fw-semibold text-muted">@item.dni</td>
                      <td><span class="fw-bold text-dark">@item.apellido, @item.nombre</span></td>
                      <td class="text-muted">@(string.IsNullOrWhiteSpace(item.telefono) ? "-" : item.telefono)</td>
                      <td>
                        @if (item.ObraSocial != null)
                        {
                          <span class="text-dark">@item.ObraSocial.nombre</span>
                        }
                        else
                        {
                          <span class="text-muted fst-italic">Sin obra social</span>
                        }
                      </td>
                      <td class="text-center">
                        @if (item.estado)
                        {
                          <span
                          class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-3 py-1">Activo</span>
                        }
                        else
                        {
                          <span
                          class="badge rounded-pill bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-1">Inactivo</span>
                        }
                      </td>
                      <td class="text-end pe-4">
                        <div class="d-inline-flex gap-1">
                          <a asp-action="Detalles" asp-route-id="@item.id" class="btn btn-outline-secondary btn-sm">Detalles</a>

                          @if (puedeGestionar)
                          {
                            <a asp-action="Editar" asp-route-id="@item.id" class="btn btn-outline-primary btn-sm">Editar</a>

                            <form asp-action="CambiarEstado" asp-route-id="@item.id" method="post" class="m-0">
                              <button type="submit" class="btn btn-outline-warning btn-sm">
                                @(item.estado ? "Desactivar" : "Activar")
                              </button>
                            </form>
                          }

                          @if (esAdmin)
                          {
                            <form asp-action="Eliminar" asp-route-id="@item.id" method="post" class="m-0"
                                  onsubmit="return confirm('Eliminar al paciente @item.apellido, @item.nombre? Esta accion no se puede deshacer.');">
                              <button type="submit" class="btn btn-outline-danger btn-sm">Eliminar</button>
                            </form>
                          }
                        </div>
                      </td>
                    </tr>
                  }
                }
                else
                {
                  <tr>
                    <td colspan="6" class="text-center py-5">
                      <p class="h6 fw-normal mb-1 text-muted">No se encontraron pacientes</p>
                      <small class="text-muted">Proba cambiando los filtros de busqueda.</small>
                    </td>
                  </tr>
                }
              </tbody>
            </table>
          </div>

          <!-- paginado -->
          <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <small class="text-muted">@Model.TotalRegistros registros - pagina @Model.Pagina de @totalPaginas</small>
            <div>
              <a asp-action="Index" asp-route-pagina="@(Model.Pagina - 1)" asp-route-buscar="@buscar"
                 asp-route-estadoFiltro="@filtro"
                 class="btn btn-outline-secondary btn-sm me-1 @(Model.TienePaginaAnterior ? "" : "disabled")">Anterior</a>
              <a asp-action="Index" asp-route-pagina="@(Model.Pagina + 1)" asp-route-buscar="@buscar"
                 asp-route-estadoFiltro="@filtro"
                 class="btn btn-outline-secondary btn-sm @(Model.TienePaginaSiguiente ? "" : "disabled")">Siguiente</a>
            </div>
          </div>
        </div>
      </div>