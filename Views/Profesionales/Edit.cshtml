@model mvc.Models.Profesional

@{
    ViewData["Title"] = $"Editar Profesional: Dr./Dra. {Model.apellido}, {Model.nombre}";
}

<div class="py-3">
    <!-- Botón para volver al listado de profesionales -->
    <div class="mb-3">
        <a asp-action="Index" class="text-decoration-none text-muted d-inline-flex align-items-center gap-1">
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z"/>
            </svg>
            <span>Volver al listado</span>
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm" style="border-radius: 12px; background: #ffffff;">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis p-2">
                                <svg width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/>
                                </svg>
                            </span>
                            <h2 class="h4 fw-bold mb-0" style="color: var(--teal, #216d68);">Editar Profesional Médico</h2>
                        </div>
                        <span class="badge bg-light text-muted border px-2 py-1">ID #@Model.id</span>
                    </div>
                    <p class="text-muted small">Actualiza los datos personales, matrícula, especialidad asignada o estado del médico.</p>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="id" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <!-- Sección 1: Datos Personales -->
                        <h6 class="fw-bold text-secondary text-uppercase mb-3 pb-1 border-bottom" style="font-size: 0.8rem; letter-spacing: 0.05em;">
                            1. Datos Personales
                        </h6>
                        <div class="row g-3 mb-4">
                            <div class="col-12 col-md-6">
                                <label asp-for="nombre" class="form-label fw-semibold text-dark">
                                    Nombre <span class="text-danger">*</span>
                                </label>
                                <input asp-for="nombre" class="form-control" placeholder="Nombre del profesional" />
                                <span asp-validation-for="nombre" class="text-danger small"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="apellido" class="form-label fw-semibold text-dark">
                                    Apellido <span class="text-danger">*</span>
                                </label>
                                <input asp-for="apellido" class="form-control" placeholder="Apellido del profesional" />
                                <span asp-validation-for="apellido" class="text-danger small"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="dni" class="form-label fw-semibold text-dark">
                                    DNI <span class="text-danger">*</span>
                                </label>
                                <input asp-for="dni" class="form-control" placeholder="DNI del profesional" />
                                <span asp-validation-for="dni" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Sección 2: Especialidad y Matrícula -->
                        <h6 class="fw-bold text-secondary text-uppercase mb-3 pb-1 border-bottom" style="font-size: 0.8rem; letter-spacing: 0.05em;">
                            2. Especialidad y Matrícula
                        </h6>
                        <div class="row g-3 mb-4">
                            <div class="col-12 col-md-6">
                                <label asp-for="matricula" class="form-label fw-semibold text-dark">
                                    Matrícula Profesional <span class="text-danger">*</span>
                                </label>
                                <input asp-for="matricula" class="form-control" placeholder="Matrícula médica" />
                                <span asp-validation-for="matricula" class="text-danger small"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="especialidad_id" class="form-label fw-semibold text-dark">
                                    Especialidad Médica <span class="text-danger">*</span>
                                </label>
                                <select asp-for="especialidad_id" asp-items="ViewBag.Especialidades" class="form-select">
                                    <option value="">-- Seleccione una especialidad --</option>
                                </select>
                                <span asp-validation-for="especialidad_id" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Sección 3: Contacto y Estado -->
                        <h6 class="fw-bold text-secondary text-uppercase mb-3 pb-1 border-bottom" style="font-size: 0.8rem; letter-spacing: 0.05em;">
                            3. Contacto y Estado
                        </h6>
                        <div class="row g-3 mb-4">
                            <div class="col-12 col-md-6">
                                <label asp-for="email" class="form-label fw-semibold text-dark">
                                    Correo Electrónico
                                </label>
                                <input asp-for="email" type="email" class="form-control" placeholder="correo@clinica.com" />
                                <span asp-validation-for="email" class="text-danger small"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="telefono" class="form-label fw-semibold text-dark">
                                    Teléfono
                                </label>
                                <input asp-for="telefono" class="form-control" placeholder="Teléfono de contacto" />
                                <span asp-validation-for="telefono" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <div class="form-check form-switch mt-2">
                                    <input class="form-check-input" type="checkbox" role="switch" asp-for="estado" id="estadoSwitch" />
                                    <label class="form-check-label fw-medium text-dark" for="estadoSwitch">
                                        Profesional Habilitado / Activo
                                    </label>
                                </div>
                                <div class="form-text small">
                                    Al desactivar a un profesional, se conserva su historial de turnos pero no se podrán agendar nuevos turnos con él/ella.
                                </div>
                            </div>
                        </div>

                        <!-- Botones de Acción -->
                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
                            <button type="submit" class="btn app-button-primary px-4">Guardar Cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
