@model IEnumerable<mvc.Models.Profesional>

@{
    ViewData["Title"] = "Profesionales Médicos";
    var currentSearch = ViewBag.Search as string;
    var currentEspecialidadId = ViewBag.EspecialidadId as int?;
    var currentFilter = ViewBag.EstadoFiltro as string ?? "todos";
    var isAdmin = User.IsInRole("Administrador");
}

<div class="py-3">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center shadow-sm mb-4" role="alert">
            <svg class="bi flex-shrink-0 me-2" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
            </svg>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- Encabezado -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h3 fw-bold mb-1" style="color: var(--teal, #216d68);">Cuerpo Médico y Profesionales</h1>
            <p class="text-muted mb-0">Gestión de profesionales de la salud, especialidades y matriculación.</p>
        </div>
        @if (isAdmin)
        {
            <div>
                <a asp-action="Create" class="btn app-button-primary px-3 shadow-sm d-inline-flex align-items-center gap-2">
                    <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2z"/>
                    </svg>
                    <span>Nuevo Profesional</span>
                </a>
            </div>
        }
    </div>

    <!-- Barra de Búsqueda y Filtros Combinados -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; background: #ffffff;">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-12 col-md-5 col-lg-5">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0 text-muted">
                            <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                            </svg>
                        </span>
                        <input type="text" name="search" value="@currentSearch" class="form-control border-start-0" 
                               placeholder="Buscar por médico, DNI o matrícula..." />
                    </div>
                </div>

                <div class="col-6 col-md-3 col-lg-3">
                    <select name="especialidadId" asp-items="ViewBag.Especialidades" class="form-select">
                        <option value="">Todas las especialidades</option>
                    </select>
                </div>

                <div class="col-6 col-md-2 col-lg-2">
                    <select name="estadoFiltro" class="form-select">
                        <option value="todos" selected="@(currentFilter == "todos")">Todos los estados</option>
                        <option value="activos" selected="@(currentFilter == "activos")">Solo activos</option>
                        <option value="inactivos" selected="@(currentFilter == "inactivos")">Solo inactivos</option>
                    </select>
                </div>

                <div class="col-12 col-md-2 col-lg-2 d-flex gap-2">
                    <button type="submit" class="btn btn-outline-secondary w-100">Filtrar</button>
                    @if (!string.IsNullOrWhiteSpace(currentSearch) || currentEspecialidadId.HasValue || currentFilter != "todos")
                    {
                        <a asp-action="Index" class="btn btn-light border text-muted" title="Limpiar filtros">✕</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla de Profesionales -->
    <div class="card border-0 shadow-sm" style="border-radius: 12px; overflow: hidden;">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color: #f1f6f4; border-bottom: 2px solid #dce6e1;">
                    <tr>
                        <th class="ps-4 text-secondary text-uppercase fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.05em;">Profesional</th>
                        <th class="text-secondary text-uppercase fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.05em;">Especialidad</th>
                        <th class="text-secondary text-uppercase fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.05em;">Matrícula / DNI</th>
                        <th class="text-secondary text-uppercase fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.05em;">Contacto</th>
                        <th class="pe-4 text-secondary text-uppercase fw-semibold text-center" style="font-size: 0.75rem; letter-spacing: 0.05em; width: 130px;">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var iniciales = $"{(!string.IsNullOrEmpty(item.nombre) ? item.nombre[0].ToString() : "")}{(!string.IsNullOrEmpty(item.apellido) ? item.apellido[0].ToString() : "")}".ToUpper();
                            <tr class="@(!item.estado ? "table-light opacity-75" : "")">
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-sm" 
                                             style="width: 40px; height: 40px; background-color: var(--teal, #216d68); font-size: 0.85rem;">
                                            @iniciales
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">Dr./Dra. @item.apellido, @item.nombre</div>
                                            <div class="text-muted small">ID: #@item.id</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-3 py-1 rounded-pill">
                                        @(item.Especialidad?.nombre ?? "Sin especialidad")
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">Matr. @item.matricula</div>
                                    <div class="text-muted small">DNI: @item.dni</div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.email))
                                    {
                                        <div class="small text-truncate" style="max-width: 220px;" title="@item.email">
                                            ✉️ @item.email
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.telefono))
                                    {
                                        <div class="small text-muted">
                                            📞 @item.telefono
                                        </div>
                                    }
                                    @if (string.IsNullOrWhiteSpace(item.email) && string.IsNullOrWhiteSpace(item.telefono))
                                    {
                                        <span class="text-muted small fst-italic">Sin contacto</span>
                                    }
                                </td>
                                <td class="pe-4 text-center">
                                    @if (item.estado)
                                    {
                                        <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-3 py-1">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-1">
                                            Inactivo
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <div class="text-muted">
                                    <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="mb-2 opacity-50">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                    </svg>
                                    <p class="h6 fw-normal mb-1">No se encontraron profesionales registrados</p>
                                    <small class="text-muted">Ajusta los filtros o da de alta un nuevo profesional médico.</small>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
