
@model IEnumerable<mvc.Models.Turno>

@{
    ViewData["Title"] = "Gestion de Turnos";
}


<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">

        <div>
            <h2 class="fw-bold mb-1">Turnos</h2>
            <p class="text-muted mb-0">
                Gestion y consulta de los turnos medicos registrados.
            </p>
        </div>

        <a asp-controller="Turnos"
           asp-action="Create"
           class="btn text-white px-4 py-3"
           style="background-color: #2f706b; border-radius: 8px; min-width: 140px;">
            <strong>Crear Turno</strong>
        </a>

    </div>


    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Hora</th>
                <th>Paciente</th>
                <th>Profesional</th>
                <th>Motivo</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var turno in Model)
            {
                <tr>
                    <td>@turno.fecha.ToString("dd/MM/yyyy")</td>
                    <td>@turno.hora.ToString("HH:mm")</td>
                    <td>
                        @(turno.Paciente != null
                            ? $"{turno.Paciente.nombre} {turno.Paciente.apellido}"
                            : "Sin paciente")
                    </td>
                    <td>
                        @(turno.Profesional != null
                            ? $"{turno.Profesional.nombre} {turno.Profesional.apellido}"
                            : "Sin profesional")
                    </td>
                    <td>@turno.motivo</td>
                    <td>@turno.estado</td>
                    <td>
                        <a asp-controller="Turnos"
                        asp-action="Edit"
                        asp-route-id="@turno.id"
                        class="btn btn-sm text-white"
                        style="background-color: #2f706b; border-radius: 6px;">
                            Editar
                        </a>
                        <form asp-controller="Turnos"
                            asp-action="Cancelar"
                            asp-route-id="@turno.id"
                            method="post"
                            onsubmit="return confirm('¿Está seguro de cancelar este turno?');"
                            style="display:inline;">

                            <button type="submit"
                                    class="btn btn-sm btn-danger">
                                Cancelar
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    
    @if (ViewBag.TotalPaginas > 1)
    {
        <nav class="mt-3">
            <ul class="pagination">

                @if (ViewBag.PaginaActual > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                        asp-action="Index"
                        asp-route-pagina="@(ViewBag.PaginaActual - 1)">
                            Anterior
                        </a>
                    </li>
                }

                @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
                {
                    <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">
                        <a class="page-link"
                        asp-action="Index"
                        asp-route-pagina="@i">
                            @i
                        </a>
                    </li>
                }

                @if (ViewBag.PaginaActual < ViewBag.TotalPaginas)
                {
                    <li class="page-item">
                        <a class="page-link"
                        asp-action="Index"
                        asp-route-pagina="@(ViewBag.PaginaActual + 1)">
                            Siguiente
                        </a>
                    </li>
                }

            </ul>
        </nav>
    }
</div>
