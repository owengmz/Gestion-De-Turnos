
@model IEnumerable<mvc.Models.Turno>

@{
    ViewData["Title"] = "Gestión de Turnos";
}

<div class="container mt-4">
    <h2>Gestión de Turnos</h2>

    <p>Listado de turnos médicos registrados.</p>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Hora</th>
                <th>Paciente</th>
                <th>Profesional</th>
                <th>Motivo</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var turno in Model)
            {
                <tr>
                    <td>@turno.fecha.ToString("dd/MM/yyyy")</td>
                    <td>@turno.hora.ToString("HH:mm")</td>
                    <td>
                        @(turno.Paciente != null
                            ? $"{turno.Paciente.nombre} {turno.Paciente.apellido}"
                            : "Sin paciente")
                    </td>
                    <td>
                        @(turno.Profesional != null
                            ? $"{turno.Profesional.nombre} {turno.Profesional.apellido}"
                            : "Sin profesional")
                    </td>
                    <td>@turno.motivo</td>
                    <td>@turno.estado</td>
                </tr>
            }
        </tbody>
    </table>

    
    @if (ViewBag.TotalPaginas > 1)
    {
        <nav class="mt-3">
            <ul class="pagination">

                @if (ViewBag.PaginaActual > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                        asp-action="Index"
                        asp-route-pagina="@(ViewBag.PaginaActual - 1)">
                            Anterior
                        </a>
                    </li>
                }

                @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
                {
                    <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">
                        <a class="page-link"
                        asp-action="Index"
                        asp-route-pagina="@i">
                            @i
                        </a>
                    </li>
                }

                @if (ViewBag.PaginaActual < ViewBag.TotalPaginas)
                {
                    <li class="page-item">
                        <a class="page-link"
                        asp-action="Index"
                        asp-route-pagina="@(ViewBag.PaginaActual + 1)">
                            Siguiente
                        </a>
                    </li>
                }

            </ul>
        </nav>
    }
</div>
