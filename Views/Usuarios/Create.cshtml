@model mvc.Models.ViewModels.CrearUsuarioViewModel

@{
    ViewData["Title"] = "Registrar Nuevo Usuario";
}

<div class="py-3">
    <!-- Volver al listado -->
    <div class="mb-3">
        <a asp-action="Index" class="text-decoration-none text-muted d-inline-flex align-items-center gap-1">
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z"/>
            </svg>
            <span>Volver al listado de usuarios</span>
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm" style="border-radius: 12px; background: #ffffff;">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge rounded-pill bg-teal-subtle p-2" style="background-color: #e6f4f2; color: var(--teal, #216d68);">
                            <svg width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M12.5 16a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm.5-5v1h1a.5.5 0 0 1 0 1h-1v1a.5.5 0 0 1-1 0v-1h-1a.5.5 0 0 1 0-1h1v-1a.5.5 0 0 1 1 0Zm-2-6a3 3 0 1 1-6 0 3 3 0 0 1 6 0ZM8 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/>
                                <path d="M8.256 14a4.474 4.474 0 0 1-.229-1.004H3c.001-.246.154-.986.832-1.664C4.484 10.68 5.711 10 8 10c.26 0 .507.009.74.025.226-.341.496-.65.804-.918C9.077 9.038 8.564 9 8 9c-5 0-6 3-6 4s1 1 1 1h5.256Z"/>
                            </svg>
                        </span>
                        <h2 class="h4 fw-bold mb-0" style="color: var(--teal, #216d68);">Registrar Nuevo Usuario</h2>
                    </div>
                    <p class="text-muted small">Crea una cuenta con credenciales seguras y define los permisos de acceso al centro médico.</p>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Create" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <!-- Sección 1: Datos Personales -->
                        <h6 class="fw-bold text-secondary text-uppercase mb-3 pb-1 border-bottom" style="font-size: 0.8rem; letter-spacing: 0.05em;">
                            1. Información Personal
                        </h6>
                        <div class="row g-3 mb-4">
                            <div class="col-12 col-md-6">
                                <label asp-for="Nombre" class="form-label fw-semibold text-dark">
                                    Nombre <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Nombre" class="form-control" placeholder="Ej. Juan" />
                                <span asp-validation-for="Nombre" class="text-danger small"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="Apellido" class="form-label fw-semibold text-dark">
                                    Apellido <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Apellido" class="form-control" placeholder="Ej. Gómez" />
                                <span asp-validation-for="Apellido" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Email" class="form-label fw-semibold text-dark">
                                    Correo Electrónico (Usuario de acceso) <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="ejemplo@centromedico.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Sección 2: Credenciales de Acceso -->
                        <h6 class="fw-bold text-secondary text-uppercase mb-3 pb-1 border-bottom" style="font-size: 0.8rem; letter-spacing: 0.05em;">
                            2. Contraseña de Seguridad
                        </h6>
                        <div class="row g-3 mb-4">
                            <div class="col-12 col-md-6">
                                <label asp-for="Password" class="form-label fw-semibold text-dark">
                                    Contraseña <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Password" type="password" class="form-control" placeholder="Mínimo 6 caracteres" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="ConfirmarPassword" class="form-label fw-semibold text-dark">
                                    Confirmar Contraseña <span class="text-danger">*</span>
                                </label>
                                <input asp-for="ConfirmarPassword" type="password" class="form-control" placeholder="Repita la contraseña" />
                                <span asp-validation-for="ConfirmarPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Sección 3: Rol y Asignación Médica -->
                        <h6 class="fw-bold text-secondary text-uppercase mb-3 pb-1 border-bottom" style="font-size: 0.8rem; letter-spacing: 0.05em;">
                            3. Rol y Permisos del Sistema
                        </h6>
                        <div class="row g-3 mb-4">
                            <div class="col-12 col-md-6">
                                <label asp-for="Rol" class="form-label fw-semibold text-dark">
                                    Rol Asignado <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Rol" id="selectRol" class="form-select">
                                    <option value="Administrador">Administrador (Control total)</option>
                                    <option value="Recepcionista" selected>Recepcionista (Operación diaria y turnos)</option>
                                    <option value="Profesional">Profesional (Acceso a agenda médica)</option>
                                </select>
                                <span asp-validation-for="Rol" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6" id="contenedorProfesional" style="display: none;">
                                <label asp-for="ProfesionalId" class="form-label fw-semibold text-dark">
                                    Vincular a Médico <span class="text-danger">*</span>
                                </label>
                                <select asp-for="ProfesionalId" asp-items="ViewBag.Profesionales" class="form-select">
                                    <option value="">-- Seleccione el profesional --</option>
                                </select>
                                <span asp-validation-for="ProfesionalId" class="text-danger small"></span>
                                <div class="form-text small">
                                    El médico seleccionado verá únicamente sus propios turnos y horarios al iniciar sesión.
                                </div>
                            </div>
                        </div>

                        <!-- Botones de Acción -->
                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
                            <button type="submit" class="btn app-button-primary px-4">Registrar Usuario</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const selectRol = document.getElementById('selectRol');
            const contenedorProfesional = document.getElementById('contenedorProfesional');

            function alternarSelectorProfesional() {
                if (selectRol.value === 'Profesional') {
                    contenedorProfesional.style.display = 'block';
                } else {
                    contenedorProfesional.style.display = 'none';
                }
            }

            selectRol.addEventListener('change', alternarSelectorProfesional);
            alternarSelectorProfesional();
        });
    </script>
}

