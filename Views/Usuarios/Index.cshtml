@model IEnumerable<mvc.Models.Usuario>

@{
    ViewData["Title"] = "Gestión de Usuarios";
    var currentSearch = ViewBag.Search as string;
    var currentRol = ViewBag.RolFiltro as mvc.Models.Rol?;
    var currentFilter = ViewBag.EstadoFiltro as string ?? "todos";
    var currentUserIdText = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    int.TryParse(currentUserIdText, out int currentUserId);
}

<div class="py-3">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center shadow-sm mb-4" role="alert">
            <svg class="bi flex-shrink-0 me-2" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
            </svg>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center shadow-sm mb-4" role="alert">
            <svg class="bi flex-shrink-0 me-2" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
            </svg>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- Encabezado -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-2 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 small">
                    Exclusivo Administrador
                </span>
                <h1 class="h3 fw-bold mb-0" style="color: var(--teal, #216d68);">Gestión de Usuarios y Accesos</h1>
            </div>
            <p class="text-muted mb-0">Control de cuentas de operadores, asignación de roles y vinculación con profesionales médicos.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn app-button-primary px-3 shadow-sm d-inline-flex align-items-center gap-2">
                <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2z"/>
                </svg>
                <span>Nuevo Usuario</span>
            </a>
        </div>
    </div>

    <!-- Barra de Búsqueda y Filtros -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; background: #ffffff;">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-12 col-md-5 col-lg-5">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0 text-muted">
                            <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                            </svg>
                        </span>
                        <input type="text" name="search" value="@currentSearch" class="form-control border-start-0" 
                               placeholder="Buscar por nombre, apellido o email..." />
                    </div>
                </div>

                <div class="col-6 col-md-3 col-lg-3">
                    <select name="rolFiltro" class="form-select">
                        <option value="">Todos los roles</option>
                        <option value="Administrador" selected="@(currentRol == mvc.Models.Rol.Administrador)">Administrador</option>
                        <option value="Recepcionista" selected="@(currentRol == mvc.Models.Rol.Recepcionista)">Recepcionista</option>
                        <option value="Profesional" selected="@(currentRol == mvc.Models.Rol.Profesional)">Profesional</option>
                    </select>
                </div>

                <div class="col-6 col-md-2 col-lg-2">
                    <select name="estadoFiltro" class="form-select">
                        <option value="todos" selected="@(currentFilter == "todos")">Todos los estados</option>
                        <option value="activos" selected="@(currentFilter == "activos")">Solo activos</option>
                        <option value="inactivos" selected="@(currentFilter == "inactivos")">Solo inactivos</option>
                    </select>
                </div>

                <div class="col-12 col-md-2 col-lg-2 d-flex gap-2">
                    <button type="submit" class="btn btn-outline-secondary w-100">Filtrar</button>
                    @if (!string.IsNullOrWhiteSpace(currentSearch) || currentRol.HasValue || currentFilter != "todos")
                    {
                        <a asp-action="Index" class="btn btn-light border text-muted" title="Limpiar filtros">✕</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla de Usuarios -->
    <div class="card border-0 shadow-sm" style="border-radius: 12px; overflow: hidden;">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color: #f1f6f4; border-bottom: 2px solid #dce6e1;">
                    <tr>
                        <th class="ps-4 text-secondary text-uppercase fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.05em;">Usuario</th>
                        <th class="text-secondary text-uppercase fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.05em;">Rol</th>
                        <th class="text-secondary text-uppercase fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.05em;">Profesional Vinculado</th>
                        <th class="text-secondary text-uppercase fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.05em;">Último Acceso</th>
                        <th class="text-secondary text-uppercase fw-semibold text-center" style="font-size: 0.75rem; letter-spacing: 0.05em; width: 110px;">Estado</th>
                        <th class="pe-4 text-secondary text-uppercase fw-semibold text-end" style="font-size: 0.75rem; letter-spacing: 0.05em; width: 140px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var iniciales = $"{(!string.IsNullOrEmpty(item.nombre) ? item.nombre[0].ToString() : "")}{(!string.IsNullOrEmpty(item.apellido) ? item.apellido[0].ToString() : "")}".ToUpper();
                            <tr class="@(!item.activo ? "table-light opacity-75" : "")">
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrWhiteSpace(item.avatar_path))
                                        {
                                            <img src="@item.avatar_path" alt="" class="rounded-circle shadow-sm" style="width: 40px; height: 40px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-sm" 
                                                 style="width: 40px; height: 40px; background-color: var(--teal, #216d68); font-size: 0.85rem;">
                                                @iniciales
                                            </div>
                                        }
                                        <div>
                                            <div class="fw-bold text-dark">@item.apellido, @item.nombre</div>
                                            <div class="text-muted small">@item.email • <span class="fst-italic">ID: #@item.id</span></div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @switch (item.rol)
                                    {
                                        case mvc.Models.Rol.Administrador:
                                            <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle px-3 py-1">
                                                Administrador
                                            </span>
                                            break;
                                        case mvc.Models.Rol.Recepcionista:
                                            <span class="badge rounded-pill bg-info-subtle text-info-emphasis border border-info-subtle px-3 py-1">
                                                Recepcionista
                                            </span>
                                            break;
                                        case mvc.Models.Rol.Profesional:
                                            <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle px-3 py-1">
                                                Profesional
                                            </span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @if (item.Profesional != null)
                                    {
                                        <div class="d-flex align-items-center gap-1 text-dark">
                                            <svg width="14" height="14" fill="currentColor" class="text-muted" viewBox="0 0 16 16">
                                                <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0Zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4Zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10Z"/>
                                            </svg>
                                            <span class="fw-medium">Dr./Dra. @item.Profesional.apellido, @item.Profesional.nombre</span>
                                        </div>
                                        <div class="text-muted small">Mat. @item.Profesional.matricula</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">Personal administrativo</span>
                                    }
                                </td>
                                <td>
                                    @if (item.fecha_ultimo_acceso.HasValue)
                                    {
                                        <span class="text-dark small">@item.fecha_ultimo_acceso.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">Nunca ingresó</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.activo)
                                    {
                                        <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-3 py-1">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-1">
                                            Inactivo
                                        </span>
                                    }
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="d-inline-flex gap-1 align-items-center">
                                        <a asp-action="Edit" asp-route-id="@item.id" class="btn btn-sm btn-outline-primary" title="Editar usuario">
                                            <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                                <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/>
                                            </svg>
                                        </a>

                                        @if (item.id == currentUserId)
                                        {
                                            <span class="badge bg-light text-muted border px-2 py-1 small" title="Tu usuario en sesión activa">
                                                Sesión
                                            </span>
                                        }
                                        else
                                        {
                                            <form asp-action="ToggleEstado" asp-route-id="@item.id" method="post" class="d-inline"
                                                  onsubmit="return confirm('¿Está seguro de que desea @(item.activo ? "desactivar" : "activar") la cuenta de @item.email?');">
                                                @Html.AntiForgeryToken()
                                                @if (item.activo)
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="Desactivar cuenta">
                                                        ⏸
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Activar cuenta">
                                                        ▶
                                                    </button>
                                                }
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="text-muted">
                                    <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="mb-2 opacity-50">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                                    </svg>
                                    <p class="h6 fw-normal mb-1">No se encontraron usuarios</p>
                                    <small class="text-muted">Ajusta los filtros de búsqueda o da de alta un nuevo operador.</small>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
